{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "desktop",
    "outDir": "dist-electron",
    "types": ["node"]
  },
  "include": ["desktop/**/*.ts", "desktop/**/*.cts"],
  "exclude": ["desktop/**/*.test.ts"]
}
